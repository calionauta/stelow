{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/calionauta/stelow/main/stelow.schema.json",
  "title": "Stelow Tracking",
  "description": "Schema for tracking product workflow execution and status",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "workflows"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL to the JSON schema"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last update timestamp"
    },
    "workflows": {
      "type": "array",
      "description": "Array of workflow entries",
      "items": {
        "$ref": "#/definitions/workflow"
      }
    }
  },
  "definitions": {
    "product-strategy": {
      "type": "object",
      "required": [
        "id",
        "skill",
        "contract"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable strategy identifier used by hosts for routing and validation"
        },
        "skill": {
          "type": "string",
          "description": "stelow-product-* skill directory implementing the playbook"
        },
        "contract": {
          "type": "string",
          "enum": [
            "single",
            "variant",
            "composite"
          ],
          "description": "Output cardinality: single integrated result, one selected variant, or named composite suboutputs"
        },
        "substeps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Expected suboutput slugs (composite only)"
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "name",
        "status",
        "phases"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable workflow identifier (e.g., 'feature-login')"
        },
        "slug": {
          "type": "string",
          "description": "[Deprecated] Legacy field, use name instead"
        },
        "description": {
          "type": "string",
          "description": "Brief description of the workflow"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "planning",
            "approved",
            "in-progress",
            "completed",
            "archived"
          ],
          "description": "Current workflow status"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 creation timestamp"
        },
        "updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 last update timestamp"
        },
        "phases": {
          "type": "array",
          "description": "Workflow phases (Shape Up stages)",
          "items": {
            "$ref": "#/definitions/phase"
          }
        },
        "stage": {
          "$ref": "#/definitions/stage-state",
          "description": "Unified stage tracking \u2014 replaces legacy current-stage.json"
        },
        "config": {
          "type": "object",
          "description": "Workflow-level config (quality, supervisor, exploration, review_mode, domains_detected). Canonical source of truth; mirrored to index.json via TS extension write-through. appetite is a deprecated alias.",
          "properties": {
            "quality": {
              "type": "string",
              "enum": [
                "production",
                "experimental"
              ],
              "description": "Verification rigor declared by human at setup"
            },
            "supervisor": {
              "type": "string",
              "enum": [
                "low",
                "med",
                "high"
              ],
              "description": "Execution checkpoint cadence declared by human at setup"
            },
            "exploration_count": {
              "type": ["string", "integer"],
              "description": "Directions compared per divergence (1-5)"
            },
            "exploration_hybrid": {
              "type": ["string", "boolean"],
              "description": "Hybrid synthesis whenever count >= 2"
            },
            "appetite": {
              "type": "string",
              "enum": [
                "Lean",
                "Core",
                "Complete"
              ],
              "description": "DEPRECATED alias, accepted and mapped once to knobs, then rewritten",
              "deprecated": true
            },
            "review_mode": {
              "type": "string",
              "description": "Review Mode: Auto / Product Spec Gate / Product Spec + Interface Gates / Product Spec + Interface + Scopes / Product Spec + Interface + Tech Review / Product Spec + Interface + Tech Review + Code Diff"
            },
            "red_first": {
              "type": "string",
              "enum": [
                "strict",
                "advisory",
                "off"
              ],
              "description": "Fail-observed enforcement: strict=BLOCK without red_proof+freeze+baseline+no-test-edit, advisory=WARN+log, off=skip. Default strict on quality production, advisory on experimental; STELOW_RED_FIRST env overrides."
            },
            "guard_judge": {
              "type": "string",
              "enum": [
                "strict",
                "advisory",
                "off"
              ],
              "description": "Guard-quality judge enforcement: strict=BLOCK new/changed guards on critical paths pending judge pass (1 revision round, then human-review), advisory=log verdicts only, off=skip. Default strict on quality production, advisory on experimental; STELOW_GUARD_JUDGE env overrides. Auto-downgrades to advisory when the trailing-30 overturn rate exceeds 0.1 (see guard-judge check)."
            },
            "domains_detected": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Domains detected during context:20 (e.g., pricing, marketplace, health)"
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional tags for categorization"
        },
        "metadata": {
          "type": "object",
          "description": "Additional workflow metadata"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/scope"
          },
          "description": "Desired scope tracking (status commits via stelow scope start|done)"
        }
      }
    },
    "stage-state": {
      "type": "object",
      "required": [
        "current_stage",
        "previous_stage",
        "transitioned_at",
        "history"
      ],
      "properties": {
        "current_stage": {
          "type": "string",
          "description": "Current stage slug (e.g., 'shape', 'planning')"
        },
        "previous_stage": {
          "type": [
            "string",
            "null"
          ],
          "description": "Previous stage slug, or null for first transition"
        },
        "transitioned_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last transition"
        },
        "history": {
          "type": "array",
          "description": "Ordered history of all stage transitions",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "entered_at"
            ],
            "properties": {
              "stage": {
                "type": "string"
              },
              "entered_at": {
                "type": "string",
                "format": "date-time"
              },
              "exited_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        },
        "supervisor_active": {
          "type": "boolean",
          "description": "Whether supervisor is active in current stage"
        }
      }
    },
    "phase": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "0-clarify",
            "1-shape",
            "2-bet",
            "3-build",
            "4-critique",
            "5-gate"
          ],
          "description": "Phase identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable phase name"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in-progress",
            "completed",
            "skipped"
          ],
          "description": "Stage status"
        },
        "started": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 start timestamp"
        },
        "completed": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 completion timestamp"
        },
        "output": {
          "type": "string",
          "description": "Path or reference to phase output artifact"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes for the phase"
        }
      }
    },
    "scope-task": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Task id (table id like 3.1, stable per spec version)"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in-progress",
            "blocked",
            "done",
            "completed",
            "skipped",
            "failed",
            "escalated"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "planned",
            "discovered"
          ]
        },
        "note": {
          "type": "string",
          "description": "Trigger note (required for discovered tasks)"
        }
      }
    },
    "scope-record": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean",
          "description": "True only when every verification-checklist item is checked"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "files_count": {
          "type": "integer"
        },
        "commands_count": {
          "type": "integer"
        },
        "baseline": {
          "type": "object"
        },
        "cost": {
          "type": [
            "object",
            "null"
          ]
        },
        "suggested_commit": {
          "type": "string"
        },
        "guard_verdicts": {
          "type": "array",
          "description": "Guard-quality judge verdicts, one per judged guard (shadow-logged from day one; see guard-quality decision spec)",
          "items": {
            "type": "object",
            "required": ["guard", "test_sha", "verdict"],
            "properties": {
              "guard": {
                "type": "string",
                "description": "Guard file path, relative to repo root"
              },
              "test_sha": {
                "type": "string",
                "description": "Frozen guard text id — re-judge only on re-freeze"
              },
              "verdict": {
                "type": "string",
                "enum": ["pass", "needs-revision", "human-review"]
              },
              "human_decision": {
                "type": "string",
                "enum": ["approved", "reworked"],
                "description": "Human decision on appeal/review; absent while pending"
              },
              "cost_tokens": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "scope-N"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in-progress",
            "blocked",
            "done",
            "completed",
            "skipped",
            "failed",
            "escalated"
          ]
        },
        "blockedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxIterations": {
          "type": "integer"
        },
        "iteration": {
          "type": "integer"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "actual_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/scope-task"
          }
        },
        "record": {
          "$ref": "#/definitions/scope-record"
        }
      }
    },
    "scope-contract": {
      "type": "object",
      "required": [
        "acceptance_criteria",
        "verify_commands",
        "test_map",
        "freeze_sha",
        "red_proof",
        "baseline"
      ],
      "properties": {
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verify_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_map": {
          "type": "object",
          "description": "P-1 fail-observed: each test file maps to the acceptance_criteria entries it guards. Every criterion must appear in at least one list — AC-sem-teste=reject.",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "freeze_sha": {
          "type": "string",
          "minLength": 1,
          "description": "SHA (short or full) of the frozen acceptance text. Tests freeze at this SHA — never edit the test to make it pass."
        },
        "red_proof": {
          "type": "object",
          "description": "Observed FAIL before the fix: the mutation/command that failed and its non-zero exit.",
          "required": ["failed_command", "exit_code"],
          "properties": {
            "failed_command": {
              "type": "string",
              "minLength": 1
            },
            "exit_code": {
              "type": "integer",
              "not": { "const": 0 }
            },
            "output_excerpt": {
              "type": "string"
            }
          }
        },
        "baseline": {
          "type": "object",
          "description": "Pre-change verify exit codes ({command: exitCode}) captured at scope start; must be non-empty ({} only when legitimately skipped AND said so in Limitations).",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    }
  }
}
