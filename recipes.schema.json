{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calionauta.stelow/schemas/recipes.schema.json",
  "type": "object",
  "required": ["id", "version", "description", "skill", "mode", "write_policy", "partition", "permission_profile", "fallback", "tasks"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "pattern": "^stelow-[a-z0-9-]+$" },
    "mode": { "enum": ["direct", "hybrid", "orchestrated"] },
    "write_policy": { "enum": ["none", "artifact", "state", "workspace"] },
    "partition": { "enum": ["none", "dependencies", "target-files", "transitive-impact", "custom"] },
    "permission_profile": { "enum": ["inherit", "per-call", "host-preset"] },
    "required_capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true },
    "preferred_capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true },
    "supporting_recipes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "fallback": {
      "type": "object",
      "required": ["mode", "preserves"],
      "additionalProperties": false,
      "properties": { "mode": { "enum": ["sequential", "refuse"] }, "preserves": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
    },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
  },
  "$defs": {
    "capability": { "enum": ["fanout", "pipeline", "structured-output", "durable-run", "resume", "cancel", "status", "hidden-workers", "human-input", "per-call-model", "per-call-permission", "isolated-workspace", "file-claims"] },
    "task": {
      "type": "object",
      "required": ["id", "skill", "depends_on", "when", "failure_policy", "output", "output_schema", "human_boundary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "skill": { "type": "string", "pattern": "^stelow-[a-z0-9-]+$" },
        "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "when": { "type": "string", "minLength": 1 },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true },
        "failure_policy": { "enum": ["fail", "skip-with-reason"] },
        "output": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[^ ]+$" },
        "output_schema": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[^ ]+$" },
        "human_boundary": { "enum": ["none", "coordinator"] }
      }
    }
  }
}
