{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["checks", "passed", "evidence"],
  "properties": {
    "checks": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "status", "evidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "failed", "skipped"] }, "evidence": { "type": "string", "minLength": 1 }, "skipReason": { "type": "string" } }, "additionalProperties": false } },
    "passed": { "type": "boolean" },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
