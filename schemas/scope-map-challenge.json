{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stelow Scope Map Challenge",
  "type": "object",
  "required": ["schemaVersion", "challengeId", "mapId", "mapShapeVersion", "kind", "affectedScopeIds", "reason", "disposition", "authority", "evidence", "requestedBy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "challengeId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
    "mapId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
    "mapShapeVersion": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["scope-boundary", "dependency-change", "product-commitment"] },
    "affectedScopeIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" } },
    "reason": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["continue", "human-decision-required", "shape-required", "research-required", "repair-brief"] },
    "authority": { "enum": ["agent", "human"] },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requestedBy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
