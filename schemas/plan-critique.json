{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["findings", "questions", "verdict"],
  "properties": {
    "findings": { "type": "array", "items": { "type": "object", "required": ["id", "severity", "evidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "severity": { "enum": ["critical", "high", "medium", "low"] }, "evidence": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
    "questions": { "type": "array", "items": { "type": "object", "required": ["id", "question"], "properties": { "id": { "type": "string", "minLength": 1 }, "question": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
    "verdict": { "enum": ["pass", "needs-revision", "blocked"] }
  },
  "additionalProperties": false
}
