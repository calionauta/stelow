{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["alternatives", "tradeoffs", "verdict"],
  "properties": {
    "alternatives": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "summary", "states"], "properties": { "id": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "states": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false } },
    "tradeoffs": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["alternativeId", "benefit", "cost"], "properties": { "alternativeId": { "type": "string", "minLength": 1 }, "benefit": { "type": "string", "minLength": 1 }, "cost": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
    "verdict": { "enum": ["ready", "needs-revision"] }
  },
  "additionalProperties": false
}
